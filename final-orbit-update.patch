+  id: 'c7-maths-as',
+  subject: 'Mathematics',
+  class: 7,
+  medium: 'Assamese',
+  sourceLang: 'Assamese',   // answers are Assamese: the translate menu offers English / Hinglish / Bengali
+  chapters: [
