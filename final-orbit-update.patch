+  t('2(' + k + '): every question has the right number of items (i, ii, iii ...), word problems have none', !!s && s.questions.every((q, i) => (q.parts || []).length === counts[i]), s && s.questions.map(q => (q.parts || []).length).join());
+}
+const qs = allQ(c);
