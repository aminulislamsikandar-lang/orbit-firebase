+++ b/freenotes-as.js
@@ -0,0 +1,245 @@
+// Assamese versions of the free notes (key = note id in freenotes.js). Same number of points as the English note, written in our own words.
+// Technical terms keep the English word in brackets so students can match it with the textbook. Please have an Assamese-medium teacher check before publishing.
+module.exports = {
+  'class-7-maths-integers': {
+    title: `পূৰ্ণসংখ্যা (Integers)`,
+    summary: `পূৰ্ণসংখ্যা (integers) হ'ল ঋণাত্মক সংখ্যা, শূন্য আৰু ধনাত্মক সংখ্যাৰ সমষ্টি: ..., -3, -2, -1, 0, 1, 2, 3, ...। এই অধ্যায়ত পূৰ্ণসংখ্যাৰ তুলনা, চাৰিটা মৌলিক প্ৰক্ৰিয়া, ধৰ্ম আৰু BODMAS ব্যৱহাৰ কৰি ৰাশি সৰল কৰা শিকা যায়।`,
+    points: [
+      `শূন্য (0) এটা পূৰ্ণসংখ্যা, কিন্তু ই ধনাত্মকো নহয়, ঋণাত্মকো নহয়।`,
+      `সংখ্যাৰেখাত সোঁফালে থকা সংখ্যাটো সদায় ডাঙৰ। প্ৰতিটো ধনাত্মক পূৰ্ণসংখ্যা 0 তকৈ ডাঙৰ আৰু 0 প্ৰতিটো ঋণাত্মক পূৰ্ণসংখ্যাতকৈ ডাঙৰ। আটাইতকৈ ডাঙৰ ঋণাত্মক পূৰ্ণসংখ্যা হ'ল -1।`,
+      `পৰম মান (absolute value) |a| হ'ল 0 ৰ পৰা a লৈ দূৰত্ব, গতিকে ই কেতিয়াও ঋণাত্মক নহয়। যেনে |-7| = 7 আৰু |7| = 7।`,
+      `a ৰ উত্তৰসূৰী (successor) হ'ল a + 1 আৰু পূৰ্বসূৰী (predecessor) হ'ল a - 1। যেনে 5 ৰ উত্তৰসূৰী 6 আৰু 0 ৰ পূৰ্বসূৰী -1।`,
+      `যোগ: একে চিনৰ সংখ্যাৰ ক্ষেত্ৰত পৰম মানবোৰ যোগ কৰি একে চিন বহুৱাওক: (-8) + (-5) = -13। বেলেগ চিনৰ ক্ষেত্ৰত ডাঙৰ পৰম মানৰ পৰা সৰু পৰম মান বিয়োগ কৰি ডাঙৰ পৰম মানৰ চিন বহুৱাওক: (-8) + 5 = -3।`,
+      `বিয়োগ: a - b = a + (-b)। এটা পূৰ্ণসংখ্যা বিয়োগ কৰা মানে তাৰ বিপৰীত সংখ্যাটো যোগ কৰা, গতিকে 5 - (-3) = 5 + 3 = 8।`,
+      `পূৰণ আৰু হৰণ: একে চিন হ'লে ফল ধনাত্মক, বেলেগ চিন হ'লে ফল ঋণাত্মক। যিকোনো সংখ্যা × 0 = 0, 0 ÷ (অশূন্য পূৰ্ণসংখ্যা) = 0, আৰু 0 ৰে হৰণ সম্ভৱ নহয়।`,
+      `সংবৃতিৰ ধৰ্ম (closure): যোগ, বিয়োগ আৰু পূৰণত পূৰ্ণসংখ্যা সংবৃত, কিন্তু হৰণত নহয় (1 ÷ 2 পূৰ্ণসংখ্যা নহয়)।`,
+      `যোগ আৰু পূৰণ বিনিময়ী (commutative) আৰু সংযোগী (associative) হয়। বিয়োগ আৰু হৰণ নহয়।`,
+      `অভেদ (identity): যোগৰ বাবে 0 (a + 0 = a) আৰু পূৰণৰ বাবে 1 (a × 1 = a)। a ৰ যোগাত্মক বিপৰীত (additive inverse) হ'ল -a।`,
+      `বণ্টন ধৰ্ম (distributive property): a × (b + c) = a × b + a × c, আৰু বিয়োগৰ ক্ষেত্ৰতো একেই হয়।`,
+      `(-1) ৰ ঘাত যুগ্ম হ'লে ফল 1 আৰু অযুগ্ম হ'লে ফল -1।`,
+      `BODMAS ক্ৰম: প্ৰথমে বন্ধনী (সৰু ( ), তাৰ পিছত { }, তাৰ পিছত [ ]), তাৰ পিছত Of, হৰণ, পূৰণ, যোগ, বিয়োগ। "Of" মানে পূৰণ।`
+    ]
+  },
+  'class-7-science-nutrition-in-plants': {
+    title: `উদ্ভিদৰ পুষ্টি (Nutrition in Plants)`,
+    summary: `পুষ্টি (nutrition) হ'ল জীৱই শক্তি, বৃদ্ধি আৰু মেৰামতিৰ বাবে খাদ্য গ্ৰহণ আৰু ব্যৱহাৰ কৰা প্ৰক্ৰিয়া। সেউজীয়া উদ্ভিদে সালোকসংশ্লেষণ (photosynthesis)ৰ দ্বাৰা নিজৰ খাদ্য নিজেই প্ৰস্তুত কৰে; আন কিছুমান উদ্ভিদে আন জীৱ বা মৃত পদাৰ্থৰ ওপৰত নিৰ্ভৰ কৰে।`,
+    points: [
+      `পুষ্টিকৰ পদাৰ্থ (nutrients) হ'ল খাদ্যৰ প্ৰয়োজনীয় উপাদান: শৰ্কৰা (carbohydrate), প্ৰ'টিন, চৰ্বি, ভিটামিন আৰু খনিজ লৱণ।`,
+      `স্বভোজী (autotroph) জীৱে নিজৰ খাদ্য নিজেই প্ৰস্তুত কৰে (সেউজীয়া উদ্ভিদ, শেলুৱৈ)। পৰভোজী (heterotroph) জীৱ আনৰ ওপৰত নিৰ্ভৰশীল (প্ৰাণী, মাশ্ৰুম, ঈষ্ট, পাউৰুটিৰ ফাংগাছ আৰু কিছুমান বেক্টেৰিয়া)।`,
+      `সালোকসংশ্লেষণত সেউজীয়া উদ্ভিদে সূৰ্যৰ পোহৰত ক্ল'ৰ'ফিলৰ সহায়ত কাৰ্বন ডাই অক্সাইড আৰু পানীৰ পৰা গ্লুক'জ প্ৰস্তুত কৰে। চমুকৈ: কাৰ্বন ডাই অক্সাইড + পানী → গ্লুক'জ + অক্সিজেন। চাৰিটা বস্তু লাগে: সূৰ্যৰ পোহৰ, ক্ল'ৰ'ফিল, কাৰ্বন ডাই অক্সাইড আৰু পানী।`,
+      `ক্ল'ৰ'ফিল হ'ল ক্ল'ৰ'প্লাষ্টৰ ভিতৰত থকা সেউজীয়া ৰঙৰ পদাৰ্থ, যি মূলতঃ পাতত পোৱা যায়। মাটিৰ পৰা পানী জাইলেম নলীৰ যোগেদি পাতলৈ যায়।`,
+      `পাতৰ তলৰ ফালে থকা স্তোমাটা (stomata) নামৰ সৰু ছিদ্ৰেৰে কাৰ্বন ডাই অক্সাইড ভিতৰলৈ সোমায় আৰু অক্সিজেন ওলাই যায়। প্ৰতিটো ছিদ্ৰ ৰক্ষী কোষ (guard cells)এ খোলে আৰু বন্ধ কৰে।`,
+      `অতিৰিক্ত গ্লুক'জ শ্বেতসাৰ (starch)লৈ সলনি হৈ শিপা, ডাল আৰু পাতত জমা থাকে।`,
+      `শ্বেতসাৰ পৰীক্ষা: পাতটো উতলাওক, পানীৰ গা-ধোৱা (water bath)ত এলকোহলত ডুবাই ৰং আঁতৰাওক, ধুই আয়'ডিন দ্ৰৱ দিয়ক। নীলা-ক'লা ৰং হ'লে শ্বেতসাৰ আছে বুলি বুজিব।`,
+      `সালোকসংশ্লেষণৰ গুৰুত্ব: ই সূৰ্যৰ শক্তিক খাদ্যৰ ৰাসায়নিক শক্তিলৈ ৰূপান্তৰ কৰে আৰু বায়ুলৈ অক্সিজেন এৰি দিয়ে।`,
+      `ৰঙা, বেঙুনীয়া বা মাটিয়া ৰঙৰ পাততো ক্ল'ৰ'ফিল থাকে; আন ৰঙৰ পদাৰ্থই সেউজীয়া ৰং ঢাকি ৰাখে। ক্যাক্টাছত পাতবোৰ সৰু কাঁইটলৈ সলনি হৈছে (পানীৰ ক্ষয় কম কৰিবলৈ) আৰু সেউজীয়া ডালেই সালোকসংশ্লেষণ কৰে।`,
+      `পৰজীৱী (parasite) উদ্ভিদে জীৱিত পোষকৰ পৰা খাদ্য লয়: কাছকিউটা (Cuscuta) — হালধীয়া, সূতাৰ দৰে, ক্ল'ৰ'ফিল নাই — আৰু ৰেফ্লেছিয়া (Rafflesia)। মিষ্টলটো (Mistletoe)ৰ পাত সেউজীয়া, গতিকে ই আংশিক পৰজীৱী; ই পোষকৰ পৰা কেৱল পানী আৰু খনিজ লয়।`,
+      `মৃতজীৱী (saprotroph) জীৱে মৰা আৰু পচি যোৱা পদাৰ্থৰ পৰা খাদ্য লয়: মাশ্ৰুম, পাউৰুটিৰ ফাংগাছ, ঈষ্ট আৰু কিছুমান বেক্টেৰিয়া।`,
+      `সহজীৱিতা (symbiosis) মানে দুটা জীৱে ইটোৱে সিটোক সহায় কৰি একেলগে বাস কৰা। লাইকেন (lichen) হ'ল শেলুৱৈ (alga) আৰু ফাংগাছৰ মিলন; ফাংগাছে পানী আৰু খনিজ দিয়ে, শেলুৱৈয়ে খাদ্য দিয়ে। ৰাইজ'বিয়াম (Rhizobium) বেক্টেৰিয়া শিমজাতীয় উদ্ভিদৰ শিপাৰ গুটিত থাকি বায়ুৰ নাইট্ৰ'জেনক উদ্ভিদে ব্যৱহাৰ কৰিব পৰা ৰূপলৈ সলনি কৰে।`,
+      `কীটভোজী (insectivorous) উদ্ভিদ (পিচাৰ প্লাণ্ট, ছানডিউ, ভেনাছ ফ্লাইট্ৰেপ, ব্লাডাৰৱৰ্ট) নাইট্ৰ'জেনৰ অভাৱ থকা মাটিত গজে, সেয়ে পোক-পতংগ ধৰি হজম কৰে। কিন্তু সিহঁতে নিজৰ খাদ্যও প্ৰস্তুত কৰিব পাৰে।`,
+      `শস্যই নাইট্ৰ'জেন, ফছফৰাছ আৰু পটাছিয়াম শুহি লোৱাত মাটিত সিহঁত কমি যায়। সাৰ (যেনে NPK), জৈৱ সাৰ আৰু শিমজাতীয় শস্য খেতি কৰি সিহঁত পূৰণ কৰা হয়; শিমজাতীয় শস্যই মাটিত নাইট্ৰ'জেন যোগ কৰে।`
+    ]
+  },
+  'class-6-maths-patterns-in-mathematics': {
+    title: `গণিতৰ ধাৰা (Patterns in Mathematics)`,
+    summary: `এই অধ্যায়ত সংখ্যাৰ ধাৰা আৰু অনুক্ৰম (sequence), আৰু সম্পূৰ্ণ সংখ্যাই (whole numbers) যোগ, বিয়োগ, পূৰণ আৰু হৰণত মানি চলা নিয়মবোৰ আলোচনা কৰা হৈছে। ধাৰাৰ নিয়ম ধৰিব পাৰিলে পৰৱৰ্তী পদ উলিওৱা আৰু হিচাপ সোনকালে কৰা সহজ হয়।`,
+    points: [
+      `স্বাভাৱিক সংখ্যা (natural numbers) 1 ৰ পৰা আৰম্ভ হয় (1, 2, 3, ...)। সম্পূৰ্ণ সংখ্যা (whole numbers) 0 ৰ পৰা আৰম্ভ হয় (0, 1, 2, 3, ...)। প্ৰতিটো স্বাভাৱিক সংখ্যা সম্পূৰ্ণ সংখ্যা, কিন্তু 0 সম্পূৰ্ণ সংখ্যা হৈও স্বাভাৱিক সংখ্যা নহয়। আটাইতকৈ ডাঙৰ সম্পূৰ্ণ সংখ্যা বুলি একো নাই।`,
+      `সংখ্যাৰেখাত সোঁফালে থকা সংখ্যা ডাঙৰ।`,
+      `সংবৃতি (closure): সম্পূৰ্ণ সংখ্যা যোগ আৰু পূৰণত সংবৃত, কিন্তু বিয়োগ (8 - 15) আৰু হৰণ (8 ÷ 3)ত নহয়।`,
+      `যোগ আৰু পূৰণ বিনিময়ী (a + b = b + a, a × b = b × a) আৰু সংযোগী। বিয়োগ আৰু হৰণ কোনোটোৱেই নহয়।`,
+      `অভেদ: যোগৰ বাবে 0 (a + 0 = a) আৰু পূৰণৰ বাবে 1 (a × 1 = a)। লগতে a × 0 = 0, আৰু a অশূন্য হ'লে 0 ÷ a = 0। 0 ৰে হৰণৰ কোনো অৰ্থ নাই।`,
+      `বণ্টন ধৰ্ম: a × (b + c) = a × b + a × c, আৰু a × (b - c) = a × b - a × c। ডাঙৰ পূৰণ সহজ অংশত ভাগ কৰিবলৈ ইয়াক ব্যৱহাৰ কৰক।`,
+      `চটকৈ হিচাপ কৰিবলৈ এনে সংখ্যা একেলগে ৰাখক যাৰ পূৰণফল গোটা সংখ্যা হয়, যেনে 4 × 25 = 100, 2 × 50 = 100 আৰু 8 × 125 = 1000।`,
+      `বিপৰীত প্ৰক্ৰিয়াই ইটোৱে সিটোক বাতিল কৰে: যোগ-বিয়োগ, পূৰণ-হৰণ। ভাজ্য = ভাজক × ভাগফল + ভাগশেষ।`,
+      `সমান্তৰ অনুক্ৰমত (arithmetic sequence) প্ৰতিবাৰ একেটা সংখ্যা যোগ কৰা হয়। গুণোত্তৰ অনুক্ৰমত (geometric sequence) প্ৰতিবাৰ একেটা সংখ্যাৰে পূৰণ কৰা হয়। কিছুমান ধাৰাত দুটা পদক্ষেপ থাকে, যেনে 4 ৰে পূৰণ কৰি তাৰ পিছত 2 ৰে হৰণ।`,
+      `বিশেষ অনুক্ৰম: যুগ্ম, অযুগ্ম, মৌলিক আৰু যৌগিক সংখ্যা; বৰ্গ সংখ্যা (1, 4, 9, 16, ...); ঘন সংখ্যা (1, 8, 27, 64, ...); ত্ৰিভুজাকাৰ সংখ্যা (1, 3, 6, 10, 15, ...); বিৰহাংক সংখ্যা (Virahanka numbers: 1, 2, 3, 5, 8, 13, ...), য'ত প্ৰতিটো পদ আগৰ দুটা পদৰ যোগফল।`,
+      `চুটি পথ: 9, 99 বা 999 যোগ কৰা মানে 10, 100 বা 1000 যোগ কৰি তাৰ পিছত 1 বিয়োগ কৰা। 99 ৰে পূৰণ কৰা মানে (100 - 1) ৰে পূৰণ কৰা।`
+    ]
+  },
+  'class-6-science-the-wonderful-world-of-science': {
+    title: `বিজ্ঞানৰ আচৰিত জগত (The Wonderful World of Science)`,
+    summary: `বিজ্ঞান হ'ল আমাৰ চাৰিওফালৰ জগত বুজিবলৈ প্ৰশ্ন কৰা, পৰ্যবেক্ষণ কৰা আৰু চিন্তা কৰাৰ এটা পদ্ধতি। ই কৌতূহলৰ পৰা আৰম্ভ হয় আৰু ৰান্ধনিশালৰ পৰা মহাকাশলৈকে সকলোতে আছে।`,
+    points: [
+      `কৌতূহল (curiosity) বিজ্ঞানৰ আটাইতকৈ গুৰুত্বপূৰ্ণ হাতিয়াৰ। বিজ্ঞান সদায় "কিয়", "কেনেকৈ", "কি" এনে প্ৰশ্নৰে আৰম্ভ হয়।`,
+      `পৰ্যবেক্ষণ (observation) হ'ল আমি ইন্দ্ৰিয়েৰে যি লক্ষ্য কৰোঁ। অনুমান বা সিদ্ধান্ত (inference) হ'ল সেই পৰ্যবেক্ষণৰ পৰা আমি উলিওৱা ব্যাখ্যা।`,
+      `বিজ্ঞান কেৱল বিদ্যালয়ৰ বিষয় বা পৰীক্ষাগাৰৰ কাম নহয়। ই এনে এক চিন্তাৰ পদ্ধতি যিয়ে সমস্যা সমাধান কৰি জীৱন উন্নত কৰাত সহায় কৰে।`,
+      `বিজ্ঞান সকলোতে আছে। ৰন্ধনত ঈষ্টে কাৰ্বন ডাই অক্সাইড গেছ উৎপন্ন কৰি আটাক ফুলাই তোলে, আৰু তাপে খাদ্যৰ সোৱাদ আৰু গঠন সলনি কৰে।`,
+      `অৱস্থাৰ সলনি: তাপত বৰফ গলে, পানী উতলি বাষ্প হয়, আৰু তাপ আঁতৰালে পানী জমি বৰফ হয়।`,
+      `জলচক্ৰ (water cycle): বাষ্পীভৱন (evaporation), ঘনীভৱন (condensation), বৰষুণ বা তুষাৰপাত (precipitation), তাৰ পিছত প্ৰবাহ আৰু ভূগৰ্ভস্থ পানী।`,
+      `বিজ্ঞান এটা বিশাল জিগ্ছ' পাজলৰ দৰে: প্ৰতিটো আৱিষ্কাৰ এটা নতুন টুকুৰা আৰু নতুন প্ৰশ্ন তুলি আনে, সেয়ে বিজ্ঞানৰ শেষ নাই।`,
+      `নতুন প্ৰমাণ পালে আগৰ বিশ্বাস সলনিও হ'ব পাৰে। প্লুটোক এসময়ত নৱম গ্ৰহ বুলি কোৱা হৈছিল, এতিয়া ইয়াক বামন গ্ৰহ (dwarf planet) বুলি শ্ৰেণীবিভাগ কৰা হয়।`,
+      `পৃথিৱী আমি জনা একমাত্ৰ গ্ৰহ য'ত জীৱন আছে। জীৱবোৰে নিজৰ পৰিৱেশৰ লগত খাপ খুৱাই লয়: ক্যাক্টাছৰ ডাল ডাঠ আৰু পানী জমা কৰে, আৰু পাতৰ ঠাইত কাঁইট থাকি পানীৰ ক্ষয় কমায়।`,
+      `প্ৰজাপতিয়ে চাৰিটা স্তৰ পাৰ হয়: কণী, লাৰ্ভা (caterpillar), পিউপা আৰু প্ৰাপ্তবয়স্ক প্ৰজাপতি।`,
+      `সকলো জীৱৰ খাদ্য আৰু পানী লাগে। খাদ্যই শক্তি আৰু বৃদ্ধিৰ বাবে পুষ্টিকৰ পদাৰ্থ দিয়ে, আৰু সুস্থ খাদ্যাভ্যাস বয়স, কামৰ পৰিমাণ আৰু প্ৰয়োজনৰ ওপৰত নিৰ্ভৰ কৰে।`
+    ]
+  },
+  'class-6-social-science-locating-places-and-reading-maps': {
+    title: `স্থান নিৰ্ণয় আৰু মানচিত্ৰ পঢ়া (Locating Places and Reading Maps)`,
+    summary: `পৃথিৱী ইমান ডাঙৰ যে আমি ইয়াক এবাৰতে চাব নোৱাৰোঁ, সেয়ে গোলক (globe) আৰু মানচিত্ৰ ব্যৱহাৰ কৰোঁ। এই অধ্যায়ত পৃথিৱীৰ আকৃতি, অক্ষাংশ আৰু দ্ৰাঘিমাংশ, আৰু সিহঁতে কেনেকৈ যিকোনো ঠাইৰ সঠিক অৱস্থান দিয়ে সেই কথা আছে।`,
+    points: [
+      `পৃথিৱী মেৰুত অলপ চেপেটা আৰু নিৰক্ষৰেখাত ওলমি থকা, সেয়ে ইয়াৰ আকৃতিক অব্লেট স্ফেৰইড (oblate spheroid) বোলা হয়। নিৰক্ষীয় ব্যাস (প্ৰায় 12,756 কিমি) মেৰুৰ ব্যাস (প্ৰায় 12,714 কিমি)তকৈ অলপ বেছি।`,
+      `গোলক (globe) পৃথিৱীৰ এটা সৰু ত্ৰিমাত্ৰিক আদৰ্শ। ই প্ৰকৃত আকৃতি, দিশ, দূৰত্ব আৰু ক্ষেত্ৰফল, লগতে দিন-ৰাতি আৰু পৃথিৱীৰ ঘূৰ্ণন দেখুৱায়।`,
+      `গোলকৰ সীমাবদ্ধতা: ই ডাঙৰ আৰু দামী, সহজে ভাঁজ কৰি কঢ়িয়াব নোৱাৰি, সৰু ঠাইৰ বিৱৰণ দেখুৱাব নোৱাৰে আৰু গোটেই পৃথিৱী এবাৰতে দেখুৱাব নোৱাৰে।`,
+      `পৃথিৱী নিজৰ অক্ষ (axis)ৰ ওপৰত ঘূৰে। অক্ষ হ'ল পৃথিৱীৰ কেন্দ্ৰৰ মাজেৰে যোৱা কাল্পনিক ৰেখা; ইয়াৰ দুটা মূৰ উত্তৰ মেৰু আৰু দক্ষিণ মেৰু। অক্ষ উলম্বৰ পৰা 23.5 ডিগ্ৰী হালি আছে।`,
+      `অক্ষাংশ (latitude) বা সমান্তৰাল ৰেখা হ'ল গোলকৰ চাৰিওফালে পৰস্পৰ সমান্তৰালকৈ থকা কাল্পনিক বৃত্ত। এইবোৰ নিৰক্ষৰেখাৰ পৰা ডিগ্ৰীত জোখা হয়। নিৰক্ষৰেখা 0 ডিগ্ৰী আৰু ই পৃথিৱীক উত্তৰ আৰু দক্ষিণ গোলাৰ্ধত ভাগ কৰে।`,
+      `গুৰুত্বপূৰ্ণ অক্ষাংশ: নিৰক্ষৰেখা (0), কৰ্কটক্ৰান্তি ৰেখা (23.5 উত্তৰ), মকৰক্ৰান্তি ৰেখা (23.5 দক্ষিণ), সুমেৰুবৃত্ত (66.5 উত্তৰ), কুমেৰুবৃত্ত (66.5 দক্ষিণ), আৰু মেৰুদ্বয় (90 উত্তৰ আৰু 90 দক্ষিণ)।`,
+      `অক্ষাংশই পৃথিৱীক তাপ মণ্ডলত ভাগ কৰাত সহায় কৰে।`,
+      `দ্ৰাঘিমাংশ (longitude) বা মধ্যাহ্নৰেখা হ'ল উত্তৰ মেৰুৰ পৰা দক্ষিণ মেৰুলৈ যোৱা কাল্পনিক ৰেখা। সিহঁত সকলোৱে সমান দৈৰ্ঘ্যৰ, সমান্তৰাল নহয় আৰু মেৰুত লগ লাগে।`,
+      `মূল মধ্যাহ্নৰেখা (Prime Meridian) 0 ডিগ্ৰী দ্ৰাঘিমা, ই লণ্ডনৰ ওচৰৰ গ্ৰীনউইচৰ ৰয়েল অবজাৰ্ভেটৰীৰ মাজেৰে যায়। ই পৃথিৱীক পূব আৰু পশ্চিম গোলাৰ্ধত ভাগ কৰে।`,
+      `আন্তৰ্জাতিক তাৰিখ ৰেখা (International Date Line) মূল মধ্যাহ্নৰেখাৰ বিপৰীতে প্ৰায় 180 ডিগ্ৰীত থাকে আৰু ইয়াত এটা দিনৰ পৰা আনটো দিন আৰম্ভ হয়। পশ্চিমলৈ পাৰ হ'লে এদিন যোগ হয় আৰু পূবলৈ পাৰ হ'লে এদিন কমে।`,
+      `অক্ষাংশ আৰু দ্ৰাঘিমাংশে একেলগে ভৌগোলিক স্থানাংক (geographic coordinates) গঠন কৰে, যিয়ে যিকোনো ঠাইৰ সঠিক অৱস্থান দিয়ে।`
+    ]
+  },
+  'class-6-english-grammar-the-sentence': {
+    title: `বাক্য (The Sentence)`,
+    summary: `বাক্য (sentence) হ'ল শব্দৰ এনে এটা দল যিয়ে সঠিক ক্ৰমত থাকি সম্পূৰ্ণ অৰ্থ প্ৰকাশ কৰে। এই অধ্যায়ত বাক্য আৰু বাক্যাংশ (phrase), বাক্যৰ চাৰিটা প্ৰকাৰ, বিস্ময়সূচক বাক্য কেনেকৈ বনাব লাগে, আৰু উদ্দেশ্য আৰু বিধেয় (subject and predicate) শিকোৱা হৈছে।`,
+    points: [
+      `বাক্যত এটা ক্ৰিয়া (verb) থাকে, ই সম্পূৰ্ণ অৰ্থ দিয়ে, ডাঙৰ আখৰেৰে আৰম্ভ হয় আৰু full stop, question mark বা exclamation markৰে শেষ হয়।`,
+      `বাক্যাংশ (phrase) হ'ল শব্দৰ এনে এটা দল যিয়ে অসম্পূৰ্ণ অৰ্থ দিয়ে। ই বাক্যৰ এটা অংশ মাথোন আৰু ইয়াত ক্ৰিয়া নাথাকিবও পাৰে। যেনে "On the phone" এটা phrase, কিন্তু "I am on the phone." এটা sentence।`,
+      `Declarative (assertive) sentence-এ তথ্য দিয়ে বা কিবা কয়, আৰু full stopৰে শেষ হয়।`,
+      `Imperative sentence-এ অনুৰোধ, উপদেশ, নিৰ্দেশ বা আদেশ দিয়ে। ই সাধাৰণতে ক্ৰিয়াৰে আৰম্ভ হয়, আৰু "you" কৰ্তা বুজা যায় কিন্তু লিখা নহয়।`,
+      `Interrogative sentence-এ প্ৰশ্ন সুধিবলৈ ব্যৱহাৰ হয়; প্ৰায়ে who, what, where, when, how, which, whose বা whyৰে আৰম্ভ হয় আৰু question markৰে শেষ হয়।`,
+      `Exclamatory sentence-এ প্ৰৱল অনুভূতি প্ৰকাশ কৰে আৰু exclamation markৰে শেষ হয়।`,
+      `এটা বাক্যক বিস্ময়সূচক কৰিবলৈ adjectiveৰ আগত a/an থাকিলে "What" ব্যৱহাৰ কৰক: "She is a graceful dancer." হৈ পৰে "What a graceful dancer she is!"`,
+      `a/an নাথাকিলে adjective বা adverbৰ লগত "How" ব্যৱহাৰ কৰক: "She dances gracefully." হৈ পৰে "How gracefully she dances!"`,
+      `প্ৰতিটো বাক্যৰ দুটা অংশ থাকে। উদ্দেশ্য (subject)ই কয় বাক্যটো কাৰ বা কিহৰ বিষয়ে। বিধেয় (predicate)ই উদ্দেশ্যৰ বিষয়ে কিবা কয় আৰু ইয়াত সদায় ক্ৰিয়া থাকে।`,
+      `উদাহৰণ: "The brown jacket was very warm." বাক্যটোত উদ্দেশ্য "The brown jacket" আৰু বিধেয় "was very warm"।`
+    ]
+  },
+  'class-10-maths-real-numbers': {
+    title: `বাস্তৱ সংখ্যা (Real Numbers)`,
+    summary: `এই অধ্যায়ত দুটা প্ৰধান কথা আছে: পাটীগণিতৰ মূল উপপাদ্য (Fundamental Theorem of Arithmetic), যাৰ মতে প্ৰতিটো যৌগিক সংখ্যাক মৌলিক উৎপাদকত মাত্ৰ এটা ধৰণেহে ভাঙিব পাৰি, আৰু √2 ৰ দৰে সংখ্যা যে অমূলদ তাৰ প্ৰমাণ।`,
+    points: [
+      `পাটীগণিতৰ মূল উপপাদ্য: প্ৰতিটো যৌগিক সংখ্যাক মৌলিক সংখ্যাৰ পূৰণফল হিচাপে লিখিব পাৰি, আৰু এই মৌলিক উৎপাদকীকৰণ উৎপাদকৰ ক্ৰম বাদে অদ্বিতীয়।`,
+      `গ.সা.গু. (HCF) হ'ল সাধাৰণ মৌলিক উৎপাদকবোৰৰ আটাইতকৈ সৰু ঘাতৰ পূৰণফল। ল.সা.গু. (LCM) হ'ল দুয়োটা সংখ্যাত থকা প্ৰতিটো মৌলিক উৎপাদকৰ আটাইতকৈ ডাঙৰ ঘাতৰ পূৰণফল।`,
+      `দুটা ধনাত্মক পূৰ্ণসংখ্যা a আৰু b ৰ বাবে: HCF(a, b) × LCM(a, b) = a × b। এই নিয়ম দুটা সংখ্যাৰ বাবেহে খাটে, তিনিটা সংখ্যাৰ বাবে নহয়।`,
+      `0 ৰে শেষ হোৱা সংখ্যাৰ মৌলিক উৎপাদকত 2 আৰু 5 দুয়োটা থাকিবই লাগিব। গতিকে 6 ৰ যিকোনো ঘাত n কেতিয়াও 0 ৰে শেষ নহয়, কাৰণ 6 ৰ মৌলিক উৎপাদক কেৱল 2 আৰু 3।`,
+      `এটা সংখ্যা যৌগিক বুলি দেখুৱাবলৈ ইয়াক 1 তকৈ ডাঙৰ দুটা সংখ্যাৰ পূৰণফল হিচাপে লিখক (সাধাৰণ উৎপাদক উলিয়াই)।`,
+      `মূলদ সংখ্যা (rational number) p/q আকাৰত লিখিব পাৰি (p, q পূৰ্ণসংখ্যা, q ≠ 0)। অমূলদ সংখ্যা (irrational number) এই আকাৰত লিখিব নোৱাৰি।`,
+      `মূল কথা: যদি মৌলিক সংখ্যা p এ a² ক হৰণ কৰে, তেন্তে p এ a কো হৰণ কৰে।`,
+      `অমূলদতাৰ প্ৰমাণ বিৰোধ পদ্ধতিৰে (contradiction) কৰা হয়। ধৰক √p = a/b (সৰ্বনিম্ন আকাৰত), দুয়োফালে বৰ্গ কৰক, দেখুৱাওক যে p এ a ক হৰণ কৰে আৰু তাৰ পিছত p এ b কো হৰণ কৰে; ই "a আৰু b ৰ কোনো সাধাৰণ উৎপাদক নাই" কথাৰ বিৰোধী।`,
+      `এটা মূলদ আৰু এটা অমূলদ সংখ্যাৰ যোগফল বা বিয়োগফল অমূলদ।`,
+      `এটা অশূন্য মূলদ আৰু এটা অমূলদ সংখ্যাৰ পূৰণফল বা ভাগফল অমূলদ।`
+    ]
+  },
+  'class-10-social-science-partition-of-bengal-and-swadeshi-movement': {
+    title: `বংগ বিভাজন আৰু স্বদেশী আন্দোলন (Partition of Bengal and Swadeshi Movement)`,
+    summary: `১৯০৫ চনত ব্ৰিটিছে বংগ বিভাজন কৰিছিল, যাৰ ফলত দেশত তৈয়াৰী বস্তু ব্যৱহাৰৰ ভিত্তিত এক বিশাল প্ৰতিবাদী আন্দোলন গঢ়ি উঠিছিল। এই আন্দোলনে ভাৰতৰ পৰৱৰ্তী জাতীয়তাবাদক গঢ় দিছিল আৰু ১৯১১ চনত বিভাজন ৰদ কৰা হৈছিল।`,
+    points: [
+      `বংগ বিভাজনৰ ঘোষণা ১৯০৫ চনৰ জুলাই মাহত ভাইচৰয় লৰ্ড কাৰ্জনে কৰিছিল আৰু ই ১৯০৫ চনৰ ১৬ অক্টোবৰত কাৰ্যকৰী হৈছিল।`,
+      `ইয়াৰ ফলত পূব বংগ আৰু অসম (ৰাজধানী ঢাকা) আৰু কলিকতাক ৰাজধানী কৰি এখন পৃথক বংগ প্ৰদেশ গঠন হৈছিল।`,
+      `চৰকাৰী কাৰণ আছিল বংগ শাসন কৰিবলৈ বেছি ডাঙৰ। প্ৰকৃত উদ্দেশ্য আছিল বংগালী জাতীয়তাবাদক দুৰ্বল কৰা আৰু হিন্দু-মুছলমানক বিভক্ত কৰা (বিভাজন আৰু শাসন নীতি)।`,
+      `১৯০৫ চনৰ ৭ আগষ্টত কলিকতাৰ টাউন হলৰ সভাত বিদেশী বস্তু বৰ্জনৰ প্ৰস্তাৱ গ্ৰহণ কৰা হৈছিল।`,
+      `১৯০৫ চনৰ ১৬ অক্টোবৰত ৰবীন্দ্ৰনাথ ঠাকুৰে হিন্দু-মুছলমানৰ ঐক্যৰ চিনস্বৰূপে ৰাখীবন্ধন অনুষ্ঠানৰ নেতৃত্ব দিছিল।`,
+      `ইয়াক স্বদেশী আন্দোলন বোলা হয় কাৰণ মানুহক নিজৰ দেশত তৈয়াৰী বস্তু (স্ব = নিজ, দেশ = দেশ) ব্যৱহাৰ কৰিবলৈ আৰু বিদেশী বস্তু বৰ্জন কৰিবলৈ কোৱা হৈছিল।`,
+      `শিক্ষা: ১৯০৬ চনত জাতীয় শিক্ষা পৰিষদ (National Council of Education) গঠন কৰা হৈছিল আৰু অৰবিন্দ ঘোষ বংগ জাতীয় মহাবিদ্যালয়ৰ প্ৰথম অধ্যক্ষ হৈছিল।`,
+      `উদ্যোগ: আচাৰ্য প্ৰফুল্লচন্দ্ৰ ৰায়ে বেংগল কেমিকেল এণ্ড ফাৰ্মাচিউটিকেল ৱাৰ্কছ স্থাপন কৰিছিল। স্বদেশী কাপোৰ কল, তাঁত, চাবোন আৰু মৃৎশিল্পৰ কাৰখানা আৰু স্বদেশী দোকানো খোলা হৈছিল।`,
+      `চৰকাৰে আন্দোলন বন্ধ কৰিবলৈ ছাত্ৰ-ছাত্ৰীৰ বিৰুদ্ধে কাৰ্লাইল সাকুলাৰ, সভা আৰু শ্লোগানৰ ওপৰত নিষেধাজ্ঞা, ১৯০৭ চনৰ ৰাজদ্ৰোহমূলক সভা আইন, ১৯০৮ চনৰ সংবাদপত্ৰ (অপৰাধত প্ৰৰোচনা) আইন, ১৯১০ চনৰ ভাৰতীয় সংবাদপত্ৰ আইন আৰু নেতাসকলক গ্ৰেপ্তাৰ কৰিছিল।`,
+      `১৯০৬ চনৰ কলিকতা অধিৱেশনত দাদাভাই নৌৰোজীৰ সভাপতিত্বত ভাৰতীয় জাতীয় কংগ্ৰেছে স্বৰাজক লক্ষ্য বুলি ঘোষণা কৰিছিল। ১৯০৭ চনত চুৰাটত কংগ্ৰেছ নৰমপন্থী আৰু চৰমপন্থীত ভাগ হৈছিল।`,
+      `১৯০৬ চনৰ ডিচেম্বৰত নৱাব ছলিমুল্লাৰ নেতৃত্বত ঢাকাত মুছলিম লীগ গঠন হৈছিল।`,
+      `১৯১১ চনৰ ১২ ডিচেম্বৰৰ দিল্লী দৰবাৰত বিভাজন ৰদ কৰাৰ ঘোষণা কৰা হৈছিল আৰু ৰাজধানী কলিকতাৰ পৰা দিল্লীলৈ স্থানান্তৰ কৰা হৈছিল। ১৯১২ চনত অসম পৃথক মুখ্য আয়ুক্ত প্ৰদেশ (Chief Commissioner's province) হৈছিল।`
+    ]
+  }
