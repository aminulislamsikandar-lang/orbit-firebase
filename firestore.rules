rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every user can read and write only their own data.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Faculty and Developer people. Any logged-in user can read; only the admin Google account(s) listed below can change.
    // >>> Replace ADMIN_EMAIL_HERE with your Google email (lowercase), e.g. 'name@gmail.com'. Add more emails separated by commas.
    function isAdmin() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email in ['aminulislamsikandar@gmail.com'];
    }
    match /people/{id} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['id', 'group', 'name', 'role', 'bio', 'order', 'photo', 'deleted'])
        && (request.resource.data.get('deleted', false) == true
            || (request.resource.data.name is string && request.resource.data.name.size() <= 80))
        && request.resource.data.get('photo', '').size() < 150000;
      allow delete: if isAdmin();
    }
    // Maths video plans: any signed-in user can read; only the admin account can write.
    match /mathVideos/{code} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        && request.resource.data.type == 'equation'
        && request.resource.data.steps is list
        && request.resource.data.steps.size() <= 12;
      allow delete: if isAdmin();
    }
    // Video lessons added from the admin panel. Signed-in users read (the app lists them); only the admin writes.
    // The file itself stays private in Backblaze; students only get a 1-hour link from the server.
    match /videos/{id} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        && id.matches('[a-z0-9][a-z0-9-]{2,79}')
        && request.resource.data.keys().hasOnly(['id', 'course', 'chapter', 'title', 'key', 'free', 'qid'])
        && request.resource.data.get('qid', '') is string && request.resource.data.get('qid', '').size() <= 60
        && request.resource.data.id == id
        && request.resource.data.course is string && request.resource.data.course.size() <= 40
        && request.resource.data.chapter is int && request.resource.data.chapter >= 1 && request.resource.data.chapter <= 99
        && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 120
        && request.resource.data.key is string && request.resource.data.key.size() >= 1 && request.resource.data.key.size() <= 200
        && request.resource.data.free is bool;
      allow delete: if isAdmin();
    }
    // Get Video. mathVideoAsked = approved library (id = hash of the normalized question): signed-in users read, only the admin writes.
    match /mathVideoAsked/{key} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['text', 'plan'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 400
        && request.resource.data.plan.type == 'equation'
        && request.resource.data.plan.steps is list
        && request.resource.data.plan.steps.size() <= 12;
      allow delete: if isAdmin();
    }
    // mathVideoPending = AI videos made by students, waiting for the admin. Any signed-in student can ADD one (never change or read others); only the admin reads, approves or deletes.
    match /mathVideoPending/{key} {
      allow create: if request.auth != null
        && key.matches('[0-9a-f]{40}')
        && request.resource.data.keys().hasOnly(['text', 'plan', 'uid', 'ts', 'qid'])
        && request.resource.data.get('qid', '') is string
        && request.resource.data.get('qid', '').size() <= 40
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ts is number
        && request.resource.data.text is string && request.resource.data.text.size() <= 400
        && request.resource.data.plan.type == 'equation'
        && request.resource.data.plan.steps is list
        && request.resource.data.plan.steps.size() <= 12;
      allow read, delete: if isAdmin();
    }
    // Science Get Video: same shape as the maths ones (plan.type is 'science').
    match /scienceVideoAsked/{key} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['text', 'plan'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 700
        && request.resource.data.plan.type == 'science'
        && request.resource.data.plan.steps is list
        && request.resource.data.plan.steps.size() <= 12;
      allow delete: if isAdmin();
    }
    match /sciencePending/{key} {
      allow create: if request.auth != null
        && key.matches('[0-9a-f]{40}')
        && request.resource.data.keys().hasOnly(['text', 'plan', 'uid', 'ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ts is number
        && request.resource.data.text is string && request.resource.data.text.size() <= 700
        && request.resource.data.plan.type == 'science'
        && request.resource.data.plan.steps is list
        && request.resource.data.plan.steps.size() <= 12;
      allow read, delete: if isAdmin();
    }
    // Subscriptions are readable by their owner but written only by you (Firebase console / admin), never by the app.
    match /subscriptions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
