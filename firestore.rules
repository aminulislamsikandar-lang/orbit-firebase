rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every user can read and write only their own data.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Faculty and Developer people. Any logged-in user can read; only the admin Google account(s) listed below can change.
    // >>> Replace ADMIN_EMAIL_HERE with your Google email (lowercase), e.g. 'name@gmail.com'. Add more emails separated by commas.
    function isAdmin() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email in ['aminulislamsikandar@gmail.com'];
    }
    match /people/{id} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['id', 'group', 'name', 'role', 'bio', 'order', 'photo', 'deleted'])
        && (request.resource.data.get('deleted', false) == true
            || (request.resource.data.name is string && request.resource.data.name.size() <= 80))
        && request.resource.data.get('photo', '').size() < 150000;
      allow delete: if isAdmin();
    }
    // Maths video plans: any signed-in user can read; only the admin account can write.
    match /mathVideos/{code} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        && request.resource.data.type == 'equation'
        && request.resource.data.steps is list
        && request.resource.data.steps.size() <= 12;
      allow delete: if isAdmin();
    }
    // Video lessons added from the admin panel. Signed-in users read (the app lists them); only the admin writes.
    // The file itself stays private in Backblaze; students only get a 1-hour link from the server.
    match /videos/{id} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        && id.matches('[a-z0-9][a-z0-9-]{2,79}')
        && request.resource.data.keys().hasOnly(['id', 'course', 'chapter', 'title', 'key', 'free', 'qid', 'kind'])
        && request.resource.data.get('qid', '') is string && request.resource.data.get('qid', '').size() <= 60
        && request.resource.data.id == id
        && request.resource.data.course is string && request.resource.data.course.size() <= 40
        && request.resource.data.chapter is int && request.resource.data.chapter >= 1 && request.resource.data.chapter <= 99
        && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 120
        && ((request.resource.data.get('kind', 'mp4') == 'mp4'
              && request.resource.data.key is string && request.resource.data.key.size() >= 1 && request.resource.data.key.size() <= 200)
            || (request.resource.data.get('kind', 'mp4') in ['plan', 'html'] && !request.resource.data.keys().hasAny(['key'])))
        && request.resource.data.free is bool;
      allow delete: if isAdmin();
    }
    // The content of a "plan" (JSON video) or "html" (self-contained animation) video added from a question's 3-dot menu. Id = the videos/{id} record.
    // Signed-in students read it when they press play; only the admin writes. HTML is shown in a sandboxed iframe (no access to the app or the login).
    match /videoCode/{id} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        && id.matches('[a-z0-9][a-z0-9-]{2,79}')
        && ((request.resource.data.keys().hasOnly(['kind', 'plan'])
              && request.resource.data.kind == 'plan'
              && request.resource.data.plan.type in ['equation', 'science']
              && request.resource.data.plan.steps is list && request.resource.data.plan.steps.size() <= 12)
            || (request.resource.data.keys().hasOnly(['kind', 'html'])
              && request.resource.data.kind == 'html'
              && request.resource.data.html is string && request.resource.data.html.size() >= 20 && request.resource.data.html.size() <= 300000));
      allow delete: if isAdmin();
    }
    // Get Video. mathVideoAsked = approved library (id = hash of the normalized question): signed-in users read, only the admin writes.
    match /mathVideoAsked/{key} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['text', 'plan'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 400
        && request.resource.data.plan.type == 'equation'
        && request.resource.data.plan.steps is list
        && request.resource.data.plan.steps.size() <= 12;
      allow delete: if isAdmin();
    }
    // mathVideoPending = AI videos made by students, waiting for the admin. Any signed-in student can ADD one (never change or read others); only the admin reads, approves or deletes.
    match /mathVideoPending/{key} {
      allow create: if request.auth != null
        && key.matches('[0-9a-f]{40}')
        && request.resource.data.keys().hasOnly(['text', 'plan', 'uid', 'ts', 'qid'])
        && request.resource.data.get('qid', '') is string
        && request.resource.data.get('qid', '').size() <= 40
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ts is number
        && request.resource.data.text is string && request.resource.data.text.size() <= 400
        && request.resource.data.plan.type == 'equation'
        && request.resource.data.plan.steps is list
        && request.resource.data.plan.steps.size() <= 12;
      allow read, delete: if isAdmin();
    }
    // Science Get Video: same shape as the maths ones (plan.type is 'science').
    match /scienceVideoAsked/{key} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['text', 'plan'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 700
        && request.resource.data.plan.type == 'science'
        && request.resource.data.plan.steps is list
        && request.resource.data.plan.steps.size() <= 12;
      allow delete: if isAdmin();
    }
    match /sciencePending/{key} {
      allow create: if request.auth != null
        && key.matches('[0-9a-f]{40}')
        && request.resource.data.keys().hasOnly(['text', 'plan', 'uid', 'ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ts is number
        && request.resource.data.text is string && request.resource.data.text.size() <= 700
        && request.resource.data.plan.type == 'science'
        && request.resource.data.plan.steps is list
        && request.resource.data.plan.steps.size() <= 12;
      allow read, delete: if isAdmin();
    }
    // Report button (Task 50): a student reports a wrong question or AI answer. Any signed-in student can ADD a report, never read, change or delete one;
    // only the admin reads, updates the status or deletes. Daily limit: the document id must be <uid>_<today as YYYYMMDD in UTC>_<1..5>, so at most
    // 5 reports a day per student (a slot can be created only once, because students can not update). The day comes from the server clock (request.time).
    match /reports/{key} {
      allow create: if request.auth != null
        && key.matches(request.auth.uid + '_' + string(request.time.year() * 10000 + request.time.month() * 100 + request.time.day()) + '_[1-5]')
        && request.resource.data.keys().hasOnly(['type', 'qid', 'course', 'lang', 'question', 'answer', 'note', 'uid', 'at', 'status'])
        && request.resource.data.type in ['question', 'answer']
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.status == 'new'
        && request.resource.data.qid is string && request.resource.data.qid.size() <= 80
        && request.resource.data.course is string && request.resource.data.course.size() <= 80
        && request.resource.data.lang is string && request.resource.data.lang.size() <= 10
        && request.resource.data.question is string && request.resource.data.question.size() <= 600
        && request.resource.data.answer is string && request.resource.data.answer.size() <= 2000
        && request.resource.data.note is string && request.resource.data.note.size() <= 200;
      allow read, delete: if isAdmin();
      allow update: if isAdmin() && request.resource.data.status in ['new', 'seen', 'fixed'];
    }
    // AI narration metadata (Sonex voice -> private Backblaze audio). Signed-in users read (the player needs the audio keys, which are useless
    // without a signed link from the server); only the admin writes. No audio is stored here, only keys and status.
    // narration/<lessonId> = { lessonId, provider:'sonex', status, updatedAt (server time),
    //   tracks: { <as|bn|en|hi|hg>: { voiceId, voiceName, speed, status, generatedAt,
    //             segments: [ { index, audioKey, contentHash, status, duration, events:[{start,end?,cue}|{start,end?,target,action}] } ] } },
    //   steps: [ { index, scene: [ { id, sprite:'car|bird|sun|flower', x, y, scale?, color? } ] } ]   (pictures per step; same for every language)
    // The admin page sets status 'ready' only after /api/narration/generate answered 'ready' (rules can not check B2, the server did).
    match /narration/{lessonId} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        && lessonId.matches('[A-Za-z0-9][A-Za-z0-9._:-]{2,119}')
        && request.resource.data.keys().hasOnly(['lessonId', 'provider', 'status', 'updatedAt', 'tracks', 'steps'])
        && request.resource.data.lessonId == lessonId
        && request.resource.data.provider == 'sonex'
        && request.resource.data.status in ['pending', 'generating', 'uploading', 'ready', 'failed']
        && request.resource.data.updatedAt == request.time
        && request.resource.data.tracks is map
        && request.resource.data.tracks.keys().hasOnly(['en', 'hi', 'as', 'bn', 'hg']);
      allow delete: if isAdmin();
    }
    // Add custom course: a student's own school/board > medium > class > subject > chapters > questions, kept in ONE document (about 1 MB max).
    // The document id is a long random id, so the share link ?cc=<id> can not be guessed. The owner reads and changes it; anybody signed in can
    // read it (get by id, never list) only while the owner has switched sharing on (shared == true). Receivers can not change it.
    // A receiver "saves" a course as users/<uid>/savedCourses/<id> (covered by the users rule above) or copies it into a new document of their own.
    function validCustomCourse(d) {
      return d.keys().hasOnly(['ownerId', 'org', 'medium', 'class', 'subject', 'lang', 'chapters', 'shared', 'updatedAt'])
        && d.ownerId is string
        && d.org is string && d.org.size() >= 2 && d.org.size() <= 60
        && d.medium in ['English', 'Assamese']
        && d['class'] is int && d['class'] >= 1 && d['class'] <= 12
        && d.subject is string && d.subject.size() >= 2 && d.subject.size() <= 40
        && d.lang in ['English', 'Hindi', 'Assamese']
        && d.chapters is list && d.chapters.size() <= 60
        && d.shared is bool
        && d.updatedAt is number;
    }
    match /customCourses/{id} {
      allow get: if request.auth != null && (resource.data.ownerId == request.auth.uid || resource.data.shared == true);
      allow list: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid && validCustomCourse(request.resource.data);
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid && validCustomCourse(request.resource.data);
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
    // Daily AI limits (limits-core.js): dailyUsage/<uid>_<IST day> = { uid, day, recall, ai, photos, expireAt }. Only the server (Admin SDK, which
    // ignores rules) reads and writes it. The app can not, so a student can not lower or reset their own count.
    // Optional: Firebase console > Firestore > TTL policy on dailyUsage.expireAt deletes old days by itself.
    match /dailyUsage/{id} {
      allow read, write: if false;
    }
    // Chapter topics (Task 31): the server (admin route) writes them once per chapter; every signed-in student can read them.
    match /chapterTopics/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Recall retention tracker (Task 15): users/<uid>/recall/tracker = { items: [{k, t, at}], updatedAt }. It is covered by the per-user rule at
    // the top (only the signed-in owner reads or writes it), so no extra rule is needed. It holds scores and times only, never the typed answer.
    // AI Kahani / Example for one question (server /api/more, admin only). Same approval rule as quizzes: students read only status 'approved'.
    // Id = question id + '__' + kind.
    function validAi(d, id) {
      return d.keys().hasOnly(['qid', 'kind', 'status', 'text', 'at'])
        && d.qid is string && d.qid.size() >= 1 && d.qid.size() <= 100
        && d.kind in ['story', 'example']
        && d.status in ['pending', 'approved']
        && d.text is string && d.text.size() >= 20 && d.text.size() <= 4000
        && d.at is number
        && id == d.qid + '__' + d.kind;
    }
    match /aicontent/{id} {
      allow get, list: if request.auth != null && (resource.data.status == 'approved' || isAdmin());
      allow create, update: if isAdmin() && validAi(request.resource.data, id);
      allow delete: if isAdmin();
    }
    // Chapter quizzes: MCQs the AI wrote from the chapter notes (server quiz-core.js), checked by the admin. Id = course__chapter__level.
    // A student can read only a quiz whose status is 'approved' (a query must also say status == 'approved'); only the admin reads pending ones and writes.
    // The questions themselves (items: [{q, o:[4 options], a:right option, e:explanation}]) are checked by the admin page, rules can only check the shape.
    function validQuiz(d, id) {
      return d.keys().hasOnly(['course', 'ch', 'level', 'status', 'items', 'at'])
        && d.course is string && d.course.size() >= 2 && d.course.size() <= 40
        && d.ch is int && d.ch >= 0 && d.ch <= 99
        && d.level in ['easy', 'medium', 'hard']
        && d.status in ['pending', 'approved']
        && d.items is list && d.items.size() >= 5 && d.items.size() <= 12
        && d.at is number
        && id == d.course + '__' + string(d.ch) + '__' + d.level;
    }
    match /quizzes/{id} {
      allow get, list: if request.auth != null && (resource.data.status == 'approved' || isAdmin());
      allow create, update: if isAdmin() && validQuiz(request.resource.data, id);
      allow delete: if isAdmin();
    }
    // Task 48: classes and homework. The class code (doc id, 6 characters) is the secret: a signed-in student can get() one class by its code, never list.
    // Only the teacher (teacherId) lists their own classes. Kept data is minimal (DPDP): school id, class number, the student's own Google name,
    // and done flags. No marks, no phone numbers, no photos.
    function clsTeacher(code) { return request.auth != null && get(/databases/$(database)/documents/classes/$(code)).data.teacherId == request.auth.uid; }
    function clsMember(code) { return request.auth != null && exists(/databases/$(database)/documents/classes/$(code)/members/$(request.auth.uid)); }
    function validHomework(d) {
      return d.keys().hasOnly(['course', 'chapter', 'title', 'due', 'note', 'createdAt'])
        && d.course is string && d.course.size() >= 1 && d.course.size() <= 40
        && d.chapter is int && d.chapter >= 1 && d.chapter <= 99
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 120
        && d.due is string && d.due.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.note is string && d.note.size() <= 200
        && d.createdAt is number;
    }
    match /classes/{code} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && resource.data.teacherId == request.auth.uid;
      allow create: if request.auth != null
        && code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['code', 'school', 'class', 'teacherId', 'createdAt'])
        && request.resource.data.code == code
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.school is string && request.resource.data.school.size() >= 2 && request.resource.data.school.size() <= 40
        && request.resource.data['class'] is int && request.resource.data['class'] >= 1 && request.resource.data['class'] <= 12
        && request.resource.data.createdAt is number;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.teacherId == request.auth.uid;
      match /members/{uid} {
        allow get: if request.auth != null && (request.auth.uid == uid || clsTeacher(code));
        allow list: if clsTeacher(code);
        allow create: if request.auth != null && request.auth.uid == uid
          && exists(/databases/$(database)/documents/classes/$(code))
          && request.resource.data.keys().hasOnly(['uid', 'name', 'joinedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
          && request.resource.data.joinedAt is number;
        allow delete: if request.auth != null && (request.auth.uid == uid || clsTeacher(code));
      }
      match /homework/{id} {
        allow read: if clsMember(code) || clsTeacher(code);
        allow create, update: if clsTeacher(code) && validHomework(request.resource.data);
        allow delete: if clsTeacher(code);
      }
      // Recall score of a chapter, one per student per chapter, so the teacher can rank the weak topics of the class. The screen shows only counts.
      match /scores/{id} {
        allow get, list: if clsTeacher(code) || (request.auth != null && resource.data.uid == request.auth.uid);
        allow create, update: if clsMember(code)
          && request.resource.data.keys().hasOnly(['ch', 'uid', 'score', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.ch is string && request.resource.data.ch.size() >= 1 && request.resource.data.ch.size() <= 60
          && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 100
          && request.resource.data.at is number
          && id == request.resource.data.ch + '_' + request.auth.uid;
        allow delete: if clsTeacher(code) || (request.auth != null && resource.data.uid == request.auth.uid);
      }
      match /done/{id} {
        allow get, list: if clsTeacher(code) || (request.auth != null && resource.data.uid == request.auth.uid);
        allow create: if clsMember(code)
          && request.resource.data.keys().hasOnly(['hw', 'uid', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.hw is string && request.resource.data.hw.size() >= 1 && request.resource.data.hw.size() <= 40
          && id == request.resource.data.hw + '_' + request.auth.uid
          && request.resource.data.at is number;
        allow delete: if clsTeacher(code) || (request.auth != null && resource.data.uid == request.auth.uid);
      }
    }
    // Subscriptions are readable by their owner but written only by you (Firebase console / admin), never by the app.
    match /subscriptions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
