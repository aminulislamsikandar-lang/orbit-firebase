GEMINI_API_KEY=your_key_here
# optional
GEMINI_MODEL=gemini-2.5-flash
# optional: more free keys from different Google projects, comma separated
GEMINI_API_KEYS=key1,key2
# optional: models in priority order, comma separated
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.8-flash
# Get Video (optional): AI videos per student per day (default 5) and admin emails with no limit
MV_DAILY=5
MV_ADMIN_EMAILS=you@gmail.com
# Admin panel can upload mp4 straight to Backblaze (needs CORS rule on the bucket and a write-enabled B2 key)
VIDEO_UPLOAD=true
VIDEO_MAX_MB=2000
# Get Video / Science video use their own model order (fast model first). Answers and translations use GEMINI_MODELS.
GEMINI_VIDEO_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.8-flash
# Backup AI providers (used only when every Gemini model/key fails). Leave a key empty to skip that provider.
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODELS=deepseek/deepseek-v4-flash:free,openrouter/free
